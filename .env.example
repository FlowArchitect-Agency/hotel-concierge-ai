# Airtable Configuration
# Get these from https://airtable.com/create/tokens (Personal Access Token with schema.bases:read/write)
AIRTABLE_API_KEY=replace-with-your-private-airtable-token
AIRTABLE_BASE_ID=replace-with-your-airtable-base-id
# Separate Airtable base for sales discovery-form submissions.
LEADS_AIRTABLE_BASE_ID=app5IahpKr1nBhU8O

# Required by the Groq AI node. Keep the real value only in your local .env.
GROQ_API_KEY=gsk_your_key_here
# Optional override. The Worker defaults to Qwen 3.6 27B in non-reasoning
# JSON mode and falls back to GPT-OSS 20B if the primary provider call fails.
# GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Required only when enabling external search through ScrapingBee.
SCRAPINGBEE_API_KEY=your_scrapingbee_key_here

# Code-native production backend (recommended; replaces hosted n8n).
# Do not commit these values. Cloudflare secrets are configured after deploy.
# Set CLOUDFLARE_API_TOKEN to your private Worker deployment token.
# CLOUDFLARE_ACCOUNT_ID=replace-with-your-cloudflare-account-id
# CONCIERGE_API_URL=https://your-worker.your-account.workers.dev/api/chat

# Optional: Hotel name used in AI prompts
HOTEL_NAME=Hôtel Lumière Paris

# Optional: Scraper provider (scrapingbee or browserless)
# SCRAPER_PROVIDER=scrapingbee
# SCRAPINGBEE_API_KEY=your_key_here
# BROWSERLESS_URL=https://chrome.browserless.io
# BROWSERLESS_TOKEN=your_token_here

# Optional: WhatsApp Business API
# WA_TOKEN=your_whatsapp_token
# WA_PHONE_NUMBER_ID=your_phone_number_id

# Optional: Instagram
# IG_TOKEN=your_instagram_token
# IG_BUSINESS_ACCOUNT_ID=your_account_id

# Optional: Twilio SMS
# TWILIO_ACCOUNT_SID=your_sid
# TWILIO_AUTH_TOKEN=your_token
# TWILIO_FROM_NUMBER=+15551234567

# Optional: Manager notifications
# MANAGER_EMAIL=manager@hotel.com
# MANAGER_WHATSAPP=+33612345678
