{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "conciergeflow-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  // Live readiness testing on 2026-09-07 saw intermittent raw Cloudflare
  // error 1102 ("Worker exceeded resource limits") under normal, light
  // conversational load. Cloudflare's own docs list only CPU time or memory
  // as causes for 1102, and this Worker had no explicit limits.cpu_ms set --
  // meaning it was running on whatever the account's default CPU-time budget
  // is, which can be as little as ~10ms of actual JS execution on some
  // plans. A single guest turn here can do JSON parsing/stringification of
  // an 8-turn history plus the service catalogue, several regex passes for
  // classification and name-matching, and response-contract validation --
  // comfortably over a 10ms budget on a heavier turn, even though none of
  // that time is spent waiting on the network (fetch time doesn't count
  // against this limit). Raising the configured ceiling costs nothing and
  // only takes effect on a Workers plan that supports it -- it cannot make
  // things worse. This does NOT change billing by itself; a request still
  // returns as soon as it finishes. Verify in the Cloudflare dashboard
  // (Workers & Pages -> conciergeflow-api -> Settings) that the account's
  // plan actually honors a value this high, and if 1102s persist afterward,
  // check Workers Logs for whether CPU or memory is the reported cause.
  "limits": { "cpu_ms": 30000 },
  "vars": {
    "ALLOWED_ORIGIN": "https://flowarchitect-agency.github.io",
    "DEMO_ALLOWED_ORIGIN": "https://flowarchitect-agency.github.io",
    "HOTEL_NAME": "H\u00f4tel Lumi\u00e8re Paris",
    "HOTEL_CITY": "Paris",
    "LEADS_AIRTABLE_BASE_ID": "app5IahpKr1nBhU8O",
    "DISCOVERY_BRIEF_PDF_FIELD_ID": "fld9dACylrANXzOS8",
    "GROQ_MODEL": "qwen/qwen3.6-27b",
    "GROQ_FALLBACK_MODEL": "openai/gpt-oss-20b"
  }
}
